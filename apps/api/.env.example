# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="skinsense-uploads"

# Sentry
SENTRY_DSN=""

# App
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="*"
