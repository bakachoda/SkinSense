# ──────────────────────────────────────────────
# SkinSense Monorepo Environment Configuration
# ──────────────────────────────────────────────

# --- Global & Node Environment ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skinsense
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skinsense?schema=public"

# --- Redis & BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- FastAPI AI Inference Service ---
INFERENCE_PORT=8000
INFERENCE_SERVICE_URL="http://localhost:8000/api/v1/inference/analyze"
TORCH_DEVICE=cpu

# --- Supabase Authentication ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="dev-super-secret-key-at-least-32-characters"

# --- Storage (AWS S3 or Supabase Storage) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test-key"
AWS_SECRET_ACCESS_KEY="test-secret"
AWS_S3_BUCKET="skinsense-scans-dev"

# --- Dermatologist Portal (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
PORTAL_PORT=3001

# --- Sentry Observability ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
